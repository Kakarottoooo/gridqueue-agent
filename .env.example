GRIDQUEUE_DB_PATH=data/processed/gridqueue.duckdb
GRIDQUEUE_API_HOST=127.0.0.1
GRIDQUEUE_API_PORT=8000
GRIDQUEUE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
GRIDQUEUE_PUBLIC_DEMO_SEED=true
GRIDQUEUE_WEB_URL=http://localhost:3000
BACKEND_API_URL=http://127.0.0.1:8000
# Optional for hosted monorepos. If BACKEND_API_URL is unset, the Next.js proxy can build it from host and port.
BACKEND_API_HOST=
BACKEND_API_PORT=
# Optional. Deterministic brief generation works without this key.
OPENAI_API_KEY=
